# Environment Variables Template for M2M Chat
# Copy this file to .env.local and fill in the values

# ===================================
# Supabase Configuration
# ===================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key for Edge Functions (NEVER expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ===================================
# Celo RPC Configuration
# ===================================
# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org

# ===================================
# Farcaster Miniapp Configuration
# ===================================
# Application URL (required for Farcaster authentication)
# For development: http://localhost:3000
# For production: https://yourdomain.com
NEXT_PUBLIC_URL=http://localhost:3000

# Application Environment
NEXT_PUBLIC_APP_ENV=development

# JWT Secret for authentication (generate a secure random string)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-here

# Farcaster Account Association Fields
# IMPORTANT: These are required for your app to work properly in Farcaster
#
# To get these values:
# 1. Deploy your app to a public domain (ngrok for testing)
# 2. Go to: https://farcaster.xyz/~/developers/mini-apps/manifest?domain=YOUR_DOMAIN
# 3. Sign the manifest with your Farcaster account
# 4. Copy the header, payload, and signature values below
#
# For local development with ngrok:
# 1. Run: ngrok http 3000
# 2. Use the ngrok URL as your domain in the manifest generator
# 3. Update NEXT_PUBLIC_URL above to match your ngrok URL
#
NEXT_PUBLIC_FARCASTER_HEADER=your-farcaster-header-here
NEXT_PUBLIC_FARCASTER_PAYLOAD=your-farcaster-payload-here
NEXT_PUBLIC_FARCASTER_SIGNATURE=your-farcaster-signature-here

# M2M Chat Smart Contract Configuration
# Public variables (accessible from frontend)
NEXT_PUBLIC_M2M_CONTRACT_ADDRESS=0xf97743261a9C1584e1C882d7d5B9CcB9DE0CdeCc
NEXT_PUBLIC_CUSD_TOKEN=0x765DE816845861e75A25fCA122bb6898B8B1282a
NEXT_PUBLIC_CHAIN_ID=42220

# Private variables (only accessible from backend API routes)
# IMPORTANT: Keep this secret! Never commit to version control
# This is the relayer wallet that signs checkpoints
RELAYER_PRIVATE_KEY=your-relayer-private-key-here

# ===================================
# XMTP Configuration
# ===================================
# XMTP environment (production or dev)
NEXT_PUBLIC_XMTP_ENV=production
